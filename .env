PORT=5000

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend-db
DB_USER=postgres
DB_PASSWORD=123456
# Or use a single connection string instead of the DB_* values above
# (hosted Postgres such as Neon, Supabase or Render):
# DATABASE_URL=postgresql://user:password@host:5432/internlink
# DB_SSL=true

JWT_SECRET=change_this_secret

# Front-end origin(s) allowed by CORS, comma separated (default shown)
# CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
